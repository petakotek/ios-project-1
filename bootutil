is_folder(){ #kontroluje v pripade, ze je -b zadano, ze slozka, ktera byla zadana existuje
    if [ ! -d "$FOLDER_TO_CHANGE" ]; then
        echo "Folder does not exists"
        exit 2
    fi
}
is_file(){
    if [ ! -f "$FILE" ]; then
        echo "Error: PATH to file does not exists"
        exit 2
    fi
}

CHANGE_DIR="$1"
shift
if [ "$CHANGE_DIR" == "-b" ]; then
    FOLDER_TO_CHANGE=$1
    is_folder "$FOLDER_TO_CHANGE"
    # echo "napsal jsi -b <$FOLDER_TO_CHANGE>"
    DEFAULT_FOLDER="$FOLDER_TO_CHANGE"
    shift # posunuti na dalsi prikaz
    COMMAND="$1"
    shift # posuniti na pozici dalsiho prikazu
else
